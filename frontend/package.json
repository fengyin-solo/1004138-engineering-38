{
  "name": "airport-ground-handling-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "repoKind": "frontend-only",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predeps": "node scripts/check-deps.cjs",
    "predev": "node scripts/check-deps.cjs",
    "dev": "vite",
    "prebuild": "node scripts/check-deps.cjs",
    "build": "vue-tsc --noEmit && vite build && node scripts/verify-build.cjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:store": "node scripts/test-migration.mjs"
  },
  "dependencies": {
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@vitejs/plugin-vue": "^5.0.4",
    "typescript": "^5.4.3",
    "vite": "^5.2.6",
    "vue-tsc": "^2.0.7"
  }
}
