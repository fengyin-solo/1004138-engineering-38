{
  "name": "airport-ground-handling-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "repoKind": "frontend-only",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/prebuild-check.cjs",
    "build": "npm run prebuild && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:init": "node scripts/test-init.mjs",
    "test:store": "node scripts/test-store.mjs",
    "test": "npm run test:init && npm run test:store",
    "predeploy:check": "node scripts/prebuild-check.cjs"
  },
  "dependencies": {
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@vitejs/plugin-vue": "^5.0.4",
    "typescript": "^5.4.3",
    "vite": "^5.2.6",
    "vue-tsc": "^2.0.7"
  }
}
